# ══════════════════════════════════════════════════════════════════
# Firebase configuration
#
# Copy to .env and fill in from:
#   Firebase console → Project settings → Your apps → SDK setup
#
# A Firebase *web* API key is not a secret. Google documents it as safe
# to expose — it identifies the project, it does not authorise anything.
# Security comes entirely from Firestore and Storage rules, which is why
# firestore.rules is the most important file in the Phase 2 sprint.
#
# .env is gitignored anyway, so that a fork or a different environment
# does not silently inherit this project's ids.
# ══════════════════════════════════════════════════════════════════

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Point the app at the local emulator suite instead of the live project.
# Leave unset in production.
VITE_USE_FIREBASE_EMULATOR=
