rules_version = '2';

/* ══════════════════════════════════════════════════════════════════
   FIRESTORE SECURITY RULES — PHASE 2

   These rules are the only real security boundary in the system. The
   React app's permission matrix decides what to *render*; this file
   decides what anyone can actually read or write. Anything enforced
   only in the client is enforced nowhere — the web API key is public
   and the SDK is scriptable.

   ⚠️ SPARK PLAN CONSTRAINT
   Roles live in `users/{docId}.role`, not in a custom auth claim.
   Custom claims require the Admin SDK, which requires a server, which
   requires Blaze. So every role check is a document lookup.

   That costs one read per rule evaluation, cached per request. It is
   the price of not running a backend, and it is why `role()` is
   called through helpers rather than inline everywhere.

   ⚠️ DOCUMENT-LEVEL, NOT FIELD-LEVEL
   Rules cannot hide a field. `hotels/{id}.commissionPercent` would be
   readable by anyone who can read the hotel, so commission lives in
   `hotels/{id}/private/commercial` — a separate document with its own
   rule. Moving it back onto the hotel would silently expose it.
   ══════════════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Identity ─────────────────────────────────────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    /** The caller's user document, found by authUid. */
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /** Exists check, so a missing profile denies rather than errors. */
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile() ? profile().role : 'none';
    }

    function active() {
      return hasProfile() && profile().status == 'active';
    }

    function isRole(r) {
      return active() && role() == r;
    }

    function isAnyRole(roles) {
      return active() && role() in roles;
    }

    function isOwnerOrAdmin() {
      return isAnyRole(['owner', 'admin']);
    }

    /**
     * ⚠️ The roles that work the WHOLE book.
     *
     * A salesperson sees only their own leads; everyone here sees all
     * of them. CRS Manager exists precisely to be a central desk, so
     * scoping it would defeat the role.
     */
    function seesEveryAccount() {
      return isAnyRole(['owner', 'admin', 'crs_manager', 'manager', 'finance', 'viewer']);
    }

    /** May raise or edit a booking, and own customers and companies. */
    function worksAccounts() {
      return isAnyRole(['owner', 'admin', 'crs_manager', 'manager', 'salesperson']);
    }

    /**
     * ⚠️ May AMEND an existing customer or company.
     *
     * A salesperson is deliberately absent. They add their own leads
     * and cannot alter them afterwards, because a customer record is
     * what an invoice and a commission attach to — changing an email
     * or a company after a booking exists silently redirects a voucher
     * or moves a stay onto a different account.
     *
     * Corrections go through the CRS desk, Admin or Owner, who see the
     * whole book and can tell a fix from a reassignment.
     */
    function amendsAccounts() {
      return isAnyRole(['owner', 'admin', 'crs_manager', 'manager']);
    }

    /**
     * Who may DESTROY a booking, as opposed to amend one.
     *
     * ⚠️ Deliberately narrower than amendsAccounts — a Manager edits
     * the book but does not delete from it. Amending leaves a record
     * and an audit row; deleting leaves a gap, and the gap is
     * unrecoverable. Kept as its own name so widening one does not
     * silently widen the other.
     */
    function removesBookings() {
      return isAnyRole(['owner', 'admin', 'crs_manager']);
    }

    /**
     * ⚠️ The one carve-out from amendsAccounts(). Creating a reservation
     * bumps totalReservations/totalRevenue/lastActivityAt on the
     * customer (and company) it belongs to, inside the same transaction
     * that writes the reservation — see reservationsRepo.create. That
     * write comes from the owning salesperson, not from the CRS desk,
     * so amendsAccounts() alone made every booking fail with "nothing
     * was saved" the moment that rule went in.
     *
     * Scoped to exactly those three fields via affectedKeys().hasOnly —
     * a salesperson still cannot slip an email or discount change in
     * alongside a legitimate roll-up.
     */
    function isAccountRollupUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['totalReservations', 'totalRevenue', 'lastActivityAt']);
    }

    /* ⚠️ `automation` is the n8n service account. It may read business
       records and drain the queue. It may never touch users, roles or
       commercial terms. */
    function isAutomation() {
      return isRole('automation');
    }

    function myUserId() {
      return request.auth.uid;
    }

    /* ── Scoping ──────────────────────────────────────────────────── */

    /** A salesperson sees only their own book. Everyone else sees all. */
    function ownsOrUnscoped(resource) {
      return role() != 'salesperson' || resource.data.ownerId == myUserId();
    }

    function writingOwnRecord() {
      return role() != 'salesperson' || request.resource.data.ownerId == myUserId();
    }

    /* ── Field guards ─────────────────────────────────────────────── */

    /** True when the write leaves `field` exactly as it was. */
    function unchanged(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* ══════════════════════════════════════════════════════════════
       USERS

       ⚠️ The most dangerous collection in the database. Anyone who can
       write their own `role` can grant themselves anything, and every
       other rule in this file trusts that field.
       ══════════════════════════════════════════════════════════════ */

    /** The invitation addressed to a given email, if any. */
    function invitationFor(email) {
      return get(/databases/$(database)/documents/invitations/$(email)).data;
    }

    function hasInvitation(email) {
      return exists(/databases/$(database)/documents/invitations/$(email));
    }

    match /invitations/{email} {
      /* ⚠️ You may read only the invitation addressed to you, and
         administrators may read them all. Anything looser turns this
         collection into a staff directory for anyone who can sign up.
         The id IS the email, which is what makes this checkable
         without a query. */
      allow read: if isOwnerOrAdmin()
        || (signedIn() && request.auth.token.email == email);

      /* ⚠️ Only an Owner may invite another Owner. Without this an
         Admin escalates in two moves: invite an Owner at an address
         they control, then sign up as it. */
      allow create, update: if isOwnerOrAdmin()
        && request.resource.data.email == email
        && (request.resource.data.role != 'owner' || isRole('owner'))
        && request.resource.data.role != 'automation';

      /* Withdrawn by an administrator, or consumed by the person
         claiming it. */
      allow delete: if isOwnerOrAdmin()
        || (signedIn() && request.auth.token.email == email);
    }

    match /users/{userId} {
      /* Everyone signed in may read the directory — names appear on
         reservations, audit rows and assignment pickers. */
      allow read: if signedIn();

      /* Claiming an invitation. This is the ONLY way a user document
         is created — there is no admin-side create, because on Spark
         an administrator cannot mint an auth account to attach one to.

         ⚠️ Three conditions carry the whole model:
           1. the id must be your own uid, so you cannot write anyone
              else's profile;
           2. an invitation must exist for your own email;
           3. the role must equal the invited role — the rule re-reads
              the invitation rather than trusting the payload, so
              editing the client hands you nothing. */
      allow create: if signedIn()
        && userId == myUserId()
        && hasInvitation(request.auth.token.email)
        && request.resource.data.role == invitationFor(request.auth.token.email).role
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'active';

      /* Administration. Owner and Admin.
         ⚠️ The owner-escalation guard is what keeps this safe and must
         not be relaxed: an Admin may edit users, but not promote anyone
         INTO 'owner' and not touch an existing Owner's record. Without
         those two clauses an Admin makes themselves an Owner in one
         write, and every other rule in this file trusts `role`.
         Nobody hands a person the n8n service account either. */
      allow update: if isOwnerOrAdmin()
        && (request.resource.data.role != 'owner' || isRole('owner'))
        && (resource.data.role != 'owner' || isRole('owner'))
        && request.resource.data.role != 'automation';

      /* Your own record: name and heartbeat only.
         ⚠️ `role` and `status` are excluded by the hasOnly, which is
         the difference between a profile edit and self-promotion. */
      allow update: if signedIn()
        && userId == myUserId()
        && changedKeys().hasOnly(['name', 'lastSeenAt', 'department', 'branch'])
        && unchanged('role')
        && unchanged('status');

      /* ⚠️ Deleting a user detaches every audit row and booking they
         touched from a name — those records keep the id and lose the
         person, permanently. Disabling by status is almost always what
         is actually wanted; this is for accounts created in error.

         An Owner's record cannot be removed by an Admin, and nobody
         may delete themselves — losing your own profile mid-session
         signs you out of an account you can no longer sign back into,
         because the profile is what `active()` reads. */
      allow delete: if isOwnerOrAdmin()
        && userId != myUserId()
        && (resource.data.role != 'owner' || isRole('owner'));
    }

    /* ══════════════════════════════════════════════════════════════
       HOTELS
       ══════════════════════════════════════════════════════════════ */

    match /hotels/{hotelId} {
      allow read: if active();
      allow create, update: if isOwnerOrAdmin() || isAnyRole(['crs_manager', 'manager']);
      allow delete: if false;

      /* ⚠️ Commercial terms. Owner and Admin only — this is the whole
         reason commission is a subcollection. A denied read here is
         expected for every other role and must not be treated as an
         error by the client. */
      match /private/{document} {
        allow read, write: if isOwnerOrAdmin();
      }
    }

    match /roomTypes/{roomTypeId} {
      allow read: if active();
      allow write: if isOwnerOrAdmin() || isAnyRole(['crs_manager', 'manager']);
    }

    match /seasons/{seasonId} {
      allow read: if active();
      allow write: if isOwnerOrAdmin() || isAnyRole(['crs_manager', 'manager']);
    }

    /* Fidato's own allotment, not the hotel's true availability.
       Nothing writes here in Phase 2; the rule exists so turning the
       screen on later is not also a security change. */
    match /inventory/{inventoryId} {
      allow read: if active();
      allow write: if isOwnerOrAdmin() || isAnyRole(['crs_manager', 'manager']);
    }

    /* ══════════════════════════════════════════════════════════════
       CRM
       ══════════════════════════════════════════════════════════════ */

    /* ⚠️ Lead ownership. A customer belongs to whoever created it, and
       another salesperson cannot read it — that is enforced here, not by
       the list query, so it holds against the SDK too. */
    match /customers/{customerId} {
      allow read: if active() && (ownsOrUnscoped(resource) || isAutomation());
      allow create: if active() && worksAccounts() && writingOwnRecord();
      allow update: if active() && (
        amendsAccounts() ||
        (worksAccounts() && ownsOrUnscoped(resource) && isAccountRollupUpdate())
      );

      /* ⚠️ Never, by anyone. A customer carries stay history, invoices
         and commission. Mark them inactive instead. */
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if active() && (ownsOrUnscoped(resource) || isAutomation());
      allow create: if active() && worksAccounts() && writingOwnRecord();
      allow update: if active() && (
        amendsAccounts() ||
        (worksAccounts() && ownsOrUnscoped(resource) && isAccountRollupUpdate())
      );
      allow delete: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       RESERVATIONS
       ══════════════════════════════════════════════════════════════ */

    match /reservations/{reservationId} {
      allow read: if active() && (ownsOrUnscoped(resource) || isAutomation());

      /* ⚠️ writingOwnRecord only constrains a salesperson. A CRS
         Manager raises bookings ON BEHALF OF a salesperson, so the
         ownerId they write is deliberately somebody else's. */
      allow create: if active() && worksAccounts() && writingOwnRecord();

      /* ⚠️ The desk amends, the salesperson does not.
         A salesperson raises a booking and it is then the CRS desk's
         record. A confirmed reservation is what an invoice, a
         commission and a voucher already in the guest's hands hang
         off; changing a date or a rate afterwards silently restates
         all three, and the person best placed to judge whether an edit
         is a correction or a reassignment is the one who can see the
         whole book.

         ⚠️ BR-04 still holds for everyone. A completed booking is an
         accounting record, not a draft — reopening it would change a
         figure an invoice was already raised against. */
      allow update: if amendsAccounts()
        && resource.data.status != 'completed';

      /* ⚠️ BR-02 said reservations are cancelled, never deleted, and
         that is still the right default — a cancellation with its
         reason is the audit story, a deletion is a hole. This exists
         for bookings raised in error, before anything was billed.

         A completed booking is never removable: an invoice or a
         commission almost certainly references it, and Firestore will
         not stop those rows pointing at nothing. Cancel instead. */
      allow delete: if removesBookings()
        && resource.data.status != 'completed';
    }

    /* ══════════════════════════════════════════════════════════════
       FINANCE
       ⚠️ Not visible to salespeople at all. Requirement: the invoice
       module is Owner, Admin and Manager only, plus Finance.
       ══════════════════════════════════════════════════════════════ */

    function financeReader() {
      return isAnyRole(['owner', 'admin', 'crs_manager', 'manager', 'finance']) || isAutomation();
    }

    match /invoices/{invoiceId} {
      allow read: if financeReader();
      allow create, update: if isAnyRole(['owner', 'admin', 'crs_manager', 'manager', 'finance']);
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if financeReader();
      allow create, update: if isAnyRole(['owner', 'admin', 'finance']);
      allow delete: if false;
    }

    /* Commission earned per booking. Owner and Admin only — same
       reasoning as the hotel's commercial terms: what Fidato earns is a
       negotiated commercial figure, not an accounting one.

       ⚠️ Finance is deliberately excluded, and the matrix in
       lib/permissions.ts now agrees. It used to grant finance
       `commission`, which did not widen access — it only advertised a
       page that opened and then failed. Reopen in BOTH places or
       neither. */
    match /commissions/{commissionId} {
      allow read, write: if isOwnerOrAdmin();
    }

    /* ══════════════════════════════════════════════════════════════
       AUDIT

       ⚠️ Append-only. On Spark the client writes these directly, so
       the trail is tamper-EVIDENT, not tamper-proof: rules can stop a
       row being altered or removed, but cannot guarantee one was
       written at all. Say so in the manual rather than implying more.
       ══════════════════════════════════════════════════════════════ */

    match /auditLogs/{logId} {
      /* ⚠️ Finance is absent here and absent from the matrix too — the
         two used to disagree, which put an Audit Log entry in finance's
         navigation that opened and then failed. The rules are the
         boundary; the matrix only decides what renders. Change both or
         neither. */
      allow read: if isAnyRole(['owner', 'admin', 'crs_manager', 'manager']);
      allow create: if active()
        && request.resource.data.actorId == myUserId();
      allow update, delete: if false;
    }

    /* ══════════════════════════════════════════════════════════════
       AUTOMATION QUEUE

       The seam to n8n. Fidato writes events; n8n drains them.
       ══════════════════════════════════════════════════════════════ */

    match /automationQueue/{eventId} {
      allow read: if isOwnerOrAdmin() || isAutomation();

      /* Any active user's action can raise an event, and it always
         starts pending — a client cannot write one already marked done
         and skip processing. */
      allow create: if active()
        && request.resource.data.status == 'pending'
        && request.resource.data.attempts == 0;

      /* n8n advances the lifecycle. An Owner or Admin may requeue a
         dead-lettered event from the queue viewer. */
      allow update: if isAutomation() || isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();
    }

    /* The n8n workflow catalogue. n8n publishes it; the app displays
       it. Nothing in the app authors a workflow. */
    match /automationWorkflows/{workflowId} {
      allow read: if active();
      allow write: if isOwnerOrAdmin() || isAutomation();
    }

    match /automationRuns/{runId} {
      allow read: if isAnyRole(['owner', 'admin', 'crs_manager', 'manager']);
      allow write: if isAutomation();
    }

    /* ══════════════════════════════════════════════════════════════
       NOTIFICATIONS & SETTINGS
       ══════════════════════════════════════════════════════════════ */

    match /notifications/{notificationId} {
      allow read, update: if active();
      allow create: if active() || isAutomation();
      allow delete: if isOwnerOrAdmin();
    }

    match /notificationTemplates/{templateId} {
      allow read: if active();
      allow write: if isOwnerOrAdmin();
    }

    match /integrations/{integrationId} {
      allow read: if isOwnerOrAdmin();
      allow write: if isOwnerOrAdmin();
    }

    match /settings/{settingId} {
      allow read: if active();
      allow write: if isOwnerOrAdmin();
    }

    /* Reference-number counters. Every booking creation touches these
       in a transaction, so any role that can create must be able to
       write them.
       ⚠️ Deliberately unguarded beyond "active". A rule that read the
       current value to check monotonicity would deadlock against the
       transaction that is incrementing it. */
    match /counters/{counterId} {
      allow read, write: if active();
    }

    /* ══════════════════════════════════════════════════════════════
       DEFAULT DENY

       Anything not named above is closed. A new collection is
       unreachable until someone writes a rule for it — which is the
       correct default, because the alternative fails open.
       ══════════════════════════════════════════════════════════════ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
