# Loaded by `vite --mode emulator` ON TOP of .env — only overrides go here.
#
# ⚠️ Points the app at the local Auth and Firestore emulators instead of
# the live project. Without this, `npm run dev` writes to PRODUCTION.
#
# No secrets in this file, which is why .gitignore makes an exception for it.
VITE_USE_FIREBASE_EMULATOR=1
