      "name": "Reservation confirmed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-320, 224],
      "webhookId": "fidato-reservation"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, reference: $json.body.data.voucher.reference }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      },
      "id": "66f03088-bfbb-4b27-b528-cd0e9df0ec16",
      "name": "Reply immediately",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-128, 224]
    },
    {
      "parameters": {
        "jsCode": "/* Base64 -> binary PDF.\n *\n * A Code node rather than Convert to File because it is one place to\n * read, and because it fails loudly: if attachPdf is off in\n * Admin -> Integrations the field is empty, and a silent empty\n * attachment is worse than an execution that stops and says why.\n */\nconst d = $('Reservation confirmed').first().json.body.data;\nconst b64 = d.voucher.pdfBase64;\n\nif (!b64) {\n  throw new Error(\n    'No PDF in the payload. Tick \"Also attach a ready-made PDF\" in ' +\n    'Fidato -> Admin -> Integrations and save, then create a booking.'\n  );\n}\n\nreturn [{\n  json: { filename: d.voucher.filename },\n  binary: {\n    data: {\n      data: b64,\n      mimeType: 'application/pdf',\n      fileName: d.voucher.filename,\n    },\n  },\n}];"
      },
      "id": "428dac28-c990-463b-a2f6-9f0e7d037f0a",
      "name": "PDF to binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [64, 224]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Reservation confirmed').item.json.body.data.to }}",
        "subject": "={{ $('Reservation confirmed').item.json.body.data.email.subject }}",
        "emailType": "html",
        "message": "={{ $('Reservation confirmed').item.json.body.data.email.html }}",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              { "property": "data" }
            ]
          }
        }
      },
      "id": "9ddf636f-38bb-4ca9-83b9-1620a2329a14",
      "name": "Email the voucher",
